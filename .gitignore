# Python
__pycache__/
*.pyc

# AI 工具内部笔记(与本仓库无关)
.codebuddy/

# 运行时数据与测试输出
data/cache.json
data/todo.json
# 抓取变更留痕(新增/改期),运行时生成,不入库
data/changes.json
# 爬虫条目 ID 登记表(改期不换 UID),运行时生成,不入库
data/event_ids.json
# 个人打钩/收藏状态(每台设备不同,不入库),接口见 /api/userstate
data/userstate.json
# 用户点「这条有问题」产生的待核查清单
data/reports.json
# 用户配置(含 webhook 凭据):首次启动由 app.py::_ensure_notify_file() 自动生成,
# 示例见 data/notify.example.json;不跟踪,避免 webhook 被 git add 带进仓库
data/notify.json
tests/_out*.txt

# Android 构建产物与本地配置
android/.gradle/
android/build/
android/app/build/
android/local.properties
# 签名密钥(含密码,不入库;请单独备份,丢失后无法覆盖升级)
android/keystore.properties
android/ycal.keystore

# 分发产物
*.apk
.ai-handoff/

# 本地切割产物(由多模态模型生成，不入库)
static/img/

# 缩略图缓存(服务端按需生成 / APK 构建前生成)
static/thumb/
android/app/src/main/assets/www/thumb/
